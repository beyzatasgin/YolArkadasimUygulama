rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Seyahat paylaşım kontrolü:
    // - Sahibi her zaman okuyup yazabilir
    // - isPublic == true ise herkes okuyabilir (anonim dahil)
    // - sharedWith listesinde e-postası olanlar okuyabilir
    function canReadTrip(data) {
      return isOwner(data.userId)
          || data.isPublic == true
          || (request.auth != null
              && request.auth.token.email != null
              && data.sharedWith != null
              && data.sharedWith is list
              && request.auth.token.email in data.sharedWith);
    }

    match /trips/{tripId} {
      allow read:   if canReadTrip(resource.data);
      allow write:  if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // Kaydedilen yerler
    match /savedPlaces/{docId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // Harcamalar
    match /expenses/{expenseId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // Seyahat fotoğrafları
    match /tripPhotos/{photoId} {
      allow read, write: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }
  }
}
