{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "functions/lib",
    "functions/node_modules",
    ".expo"
  ]
}
