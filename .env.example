# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# AI — istemci modu (proxy kapalıyken)
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key
EXPO_PUBLIC_AI_PROVIDER=auto

# Google Places — istemci modu (proxy kapalıyken)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# API proxy (önerilen üretim)
EXPO_PUBLIC_USE_API_PROXY=false
EXPO_PUBLIC_FUNCTIONS_REGION=europe-west1
EXPO_PUBLIC_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# Google Sign-In
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
